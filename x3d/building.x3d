<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3"
     xmlns="http://www.web3d.org/specifications/x3d-namespace">

<!-- Złożenie budynku DS1 Olimp z części. Każda część ma współrzędne budynku
     (y = 0 to podłoga parteru); tutaj cały budynek jest podnoszony o wysokość fundamentu.
     Ścieżki względem tego pliku -->

<Scene>

    <!-- Cały budynek podniesiony o 0.6 m - fundament wystaje ponad teren -->
    <Transform translation="0 0.6 0">

        <!-- Konstrukcja -->
        <Inline url='"structure/foundation.x3d"'/>
        <Inline url='"structure/walls.x3d"'/>
        <Inline url='"structure/slabs.x3d"'/>
        <Inline url='"structure/roof.x3d"'/>

        <!-- Elewacje i elementy we wnękach -->
        <Inline url='"facade/facade.x3d"'/>
        <Inline url='"entrance/entrance.x3d"'/>
        <Inline url='"balconies/balconies.x3d"'/>
        <Inline url='"fire-escape/fire-escape.x3d"'/>

        <!-- Wnętrze -->
        <Inline url='"interior/units.x3d"'/>

    </Transform>

    <!-- Otoczenie -->
    <Inline url='"environment/terrain.x3d"'/>

</Scene>
</X3D>