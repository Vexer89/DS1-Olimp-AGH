    </Transform>


    <!-- ====================================== -->
    <!-- KLATKA EWAKUACYJNA -->
    <!-- ====================================== -->

    <Transform translation="0 2.8 0"><Group USE="FIRE_ESCAPE_MODULE"/></Transform>
    <Transform translation="0 5.6 0"><Group USE="FIRE_ESCAPE_MODULE"/></Transform>
    <Transform translation="0 8.4 0"><Group USE="FIRE_ESCAPE_MODULE"/></Transform>
    <Transform translation="0 11.2 0"><Group USE="FIRE_ESCAPE_MODULE"/></Transform>
    <Transform translation="0 14 0"><Group USE="FIRE_ESCAPE_MODULE"/></Transform>
