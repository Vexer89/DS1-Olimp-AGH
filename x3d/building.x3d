            <IndexedFaceSet solid="false"
                coordIndex="0 1 2 3 -1 4 5 6 7 -1 0 1 5 4 -1 1 2 6 5 -1 2 3 7 6 -1 3 0 4 7 -1">
                <Coordinate point="15.6 0.6 -0.05, 16.0 0.2 -0.05, 16.0 -0.6 -0.05, 15.6 -0.6 -0.05,
                                   15.6 0.6 0.05, 16.0 0.2 0.05, 16.0 -0.6 0.05, 15.6 -0.6 0.05"/>
            </IndexedFaceSet>
        </Shape>
    </Transform>

    <Transform translation="15.8 0.485 1.75" rotation="0 0 1 0.7854">
        <Shape>
            <Appearance USE="PIPE_APPEARANCE"/>
            <Cylinder radius="0.025" height="0.57"/>
        </Shape>
    </Transform>
    <Transform translation="15.8 0.425 1.75"><Shape USE="PIPE_POST"/></Transform>

    <!-- Kolumna w środku klatki: tylko ściany od strony biegów,
         bez ściany zewnętrznej i bez ściany od strony wnęki -->
    <!-- Od terenu (y = -0.6) do wierzchu murku najwyższej płyty (y = 42.6) -->
    <Transform translation="16.3 21.0 0.65">
        <Shape DEF="FIRE_COLUMN_WALL">
            <Appearance USE="FIRE_PARAPET_APPEARANCE"/>
            <Box size="1.4 43.2 0.1"/>
        </Shape>
    </Transform>
    <Transform translation="16.3 21.0 -0.65"><Shape USE="FIRE_COLUMN_WALL"/></Transform>

    <!-- Najwyższa płyta (y = 42): murek w miejscu, gdzie dochodziłby bieg z góry -->
    <Transform translation="15.65 42.2 -1.2">
        <Shape>
            <Appearance USE="FIRE_PARAPET_APPEARANCE"/>
            <Box size="0.1 0.8 1.0"/>
        </Shape>
    </Transform>

    <!-- Rurka na tym murku - Cylinder obrócony z osi Y na oś Z -->
    <Transform translation="15.65 42.675 -1.2" rotation="1 0 0 1.5708">
