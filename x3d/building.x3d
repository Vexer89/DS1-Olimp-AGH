<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3"
     xmlns="http://www.web3d.org/specifications/x3d-namespace">

<Scene>

    <!-- Cały budynek podniesiony o 0.6 m - fundament wystaje ponad teren -->
    <Transform translation="0 0.6 0">

    <!-- ====================================== -->
    <!-- FUNDAMENT -->
    <!-- ====================================== -->

    <!-- Cofnięty o 0.1 m względem lica ścian.
         Bez fundamentu we wnęce klatki ewakuacyjnej (x: 14.6 .. 18, z: -2.8 .. 2.8) -->
    <Transform translation="-8.95 -0.3 0">
        <Shape>
            <Appearance DEF="FOUNDATION_APPEARANCE">
                <Material diffuseColor="0.12 0.12 0.13"/>
            </Appearance>   
            <Box size="17.9 0.6 19.8"/>
        </Shape>
    </Transform>

    <Transform translation="16.25 -0.3 6.275">
        <Shape>
            <Appearance USE="FOUNDATION_APPEARANCE"/>
            <Box size="3.3 0.6 6.95"/>
        </Shape>
    </Transform>

    <Transform translation="16.25 -0.3 -6.275">
        <Shape>
            <Appearance USE="FOUNDATION_APPEARANCE"/>
            <Box size="3.3 0.6 6.95"/>
        </Shape>
    </Transform>

    <!-- Połowa od strony klatki: rdzeń cofnięty o 0.15 m (z = ±9.75), przed nim warstwa z oknami piwnicznymi -->
    <Transform translation="7.3 -0.3 0">
        <Shape>
            <Appearance USE="FOUNDATION_APPEARANCE"/>
            <Box size="14.6 0.6 19.5"/>
        </Shape>
    </Transform>

    <!-- Okna piwniczne - 6 na każdej długiej ścianie, tylko w połowie od strony klatki (x: 0 .. 18).
         Okna i odstępy tej samej szerokości: 18 / 13 = 1.385 m (7 odstępów + 6 okien) -->
    <Transform translation="2.077 -0.3 9.75">
        <Group DEF="BASEMENT_WINDOW">
            <Transform translation="0 0 0.015">
                <Shape>
                    <Appearance>
                        <Material diffuseColor="0.60 0.60 0.60"/>
                    </Appearance>
                    <Box size="1.385 0.3 0.03"/>
                </Shape>
            </Transform>

            <Transform translation="0 0 0.03">
                <Shape>
                    <Appearance>
                        <Material diffuseColor="0.12 0.15 0.17"
                                  specularColor="0.5 0.5 0.5"
                                  shininess="0.6"/>
                    </Appearance>
                    <Box size="1.265 0.18 0.02"/>
                </Shape>
            </Transform>
        </Group>
    </Transform>
    <Transform translation="4.846 -0.3 9.75"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="7.615 -0.3 9.75"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="10.385 -0.3 9.75"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="13.154 -0.3 9.75"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="15.923 -0.3 9.75"><Group USE="BASEMENT_WINDOW"/></Transform>

    <!-- Druga ściana: obrót o 180° wokół Y kieruje okno na zewnątrz (-Z) -->
    <Transform translation="2.077 -0.3 -9.75" rotation="0 1 0 3.14159"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="4.846 -0.3 -9.75" rotation="0 1 0 3.14159"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="7.615 -0.3 -9.75" rotation="0 1 0 3.14159"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="10.385 -0.3 -9.75" rotation="0 1 0 3.14159"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="13.154 -0.3 -9.75" rotation="0 1 0 3.14159"><Group USE="BASEMENT_WINDOW"/></Transform>
    <Transform translation="15.923 -0.3 -9.75" rotation="0 1 0 3.14159"><Group USE="BASEMENT_WINDOW"/></Transform>

    <!-- Warstwa zewnętrzna fundamentu z otworami (gr. 0.15 m, z: 9.75 .. 9.9) -
         pasy pod i nad oknami oraz filary w odstępach między oknami -->
    <Transform translation="0 0 9.825">
        <Group DEF="BASEMENT_SKIN">
            <Transform translation="8.95 -0.525 0">
                <Shape DEF="BASEMENT_SKIN_STRIP">
                    <Appearance USE="FOUNDATION_APPEARANCE"/>
                    <Box size="17.9 0.15 0.15"/>
                </Shape>
            </Transform>
            <Transform translation="8.95 -0.075 0"><Shape USE="BASEMENT_SKIN_STRIP"/></Transform>

            <Transform translation="0.692 -0.3 0">
                <Shape DEF="BASEMENT_SKIN_PIER">
                    <Appearance USE="FOUNDATION_APPEARANCE"/>
                    <Box size="1.385 0.3 0.15"/>
                </Shape>
            </Transform>
            <Transform translation="3.462 -0.3 0"><Shape USE="BASEMENT_SKIN_PIER"/></Transform>
            <Transform translation="6.231 -0.3 0"><Shape USE="BASEMENT_SKIN_PIER"/></Transform>
            <Transform translation="9.0 -0.3 0"><Shape USE="BASEMENT_SKIN_PIER"/></Transform>
            <Transform translation="11.769 -0.3 0"><Shape USE="BASEMENT_SKIN_PIER"/></Transform>
            <Transform translation="14.538 -0.3 0"><Shape USE="BASEMENT_SKIN_PIER"/></Transform>

            <!-- Ostatni filar do końca fundamentu (x = 17.9) -->
            <Transform translation="17.258 -0.3 0">
                <Shape>
                    <Appearance USE="FOUNDATION_APPEARANCE"/>
                    <Box size="1.285 0.3 0.15"/>
                </Shape>
            </Transform>
        </Group>
    </Transform>
    <Transform translation="0 0 -9.825"><Group USE="BASEMENT_SKIN"/></Transform>

    <!-- ====================================== -->
    <!-- KONSTRUKCJA ŚCIAN BUDYNKU -->
    <!-- ====================================== -->

    <!-- Długie ściany z otworami okiennymi są budowane w FLOOR_MODULE -->

    <!-- Krótsza ściana prawa - strona dodatniego Z -->
    <Transform translation="17.95 22.4 6.4">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="0.1 44.8 7.2"/>
        </Shape>
    </Transform>

    <!-- Krótsza ściana prawa - strona ujemnego Z -->
    <Transform translation="17.95 22.4 -6.4">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="0.1 44.8 7.2"/>
        </Shape>
    </Transform>

    <!-- Krótsza ściana lewa - strona dodatniego Z -->
    <Transform translation="-17.95 22.4 6.4">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="0.1 44.8 7.2"/>
        </Shape>
    </Transform>

    <!-- Krótsza ściana lewa - strona ujemnego Z -->
    <Transform translation="-17.95 22.4 -6.4">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="0.1 44.8 7.2"/>
        </Shape>
    </Transform>

    <!-- Wnęka: 5.60 m szerokości, 3.40 m w głąb, od parteru do dachu -->
    <Transform translation="-14.55 22.4 0">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="0.1 44.8 5.6"/>
        </Shape>
    </Transform>

    <Transform translation="-16.25 22.4 2.85">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="3.3 44.8 0.1"/>
        </Shape>
    </Transform>

    <Transform translation="-16.25 22.4 -2.85">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="3.3 44.8 0.1"/>
        </Shape>
    </Transform>

    <Transform translation="-16.3 0.02 0">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.72 0.71 0.68"/>
            </Appearance>
            <Box size="3.4 0.04 5.6"/>
        </Shape>
    </Transform>

    <!-- Wnęka klatki ewakuacyjnej - lustrzane odbicie wnęki wejściowej -->
    <Transform translation="14.55 22.4 0">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="0.1 44.8 5.6"/>
        </Shape>
    </Transform>

    <Transform translation="16.25 22.4 2.85">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="3.3 44.8 0.1"/>
        </Shape>
    </Transform>

    <Transform translation="16.25 22.4 -2.85">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.78 0.77 0.73"/>
            </Appearance>
            <Box size="3.3 44.8 0.1"/>
        </Shape>
    </Transform>

    <Switch whichChoice="-1">

    <!-- ====================================== -->
    <!-- MODUŁ OKNA -->
    <!-- ====================================== -->

    <!-- Otwór 2.3 x 1.5 m. z = 0 to lico ściany - okno jest cofnięte w głąb:
         rama i słupki od -0.38 do -0.30, szyba na -0.34 -->
    <Group DEF="WINDOW_UNIT">

        <Transform translation="0 0 -0.34">
            <Shape>
                <Appearance>
                    <Material diffuseColor="0.35 0.49 0.55"
                              specularColor="0.3 0.3 0.3"
                              shininess="0.3"/>
                </Appearance>
                <Box size="2.16 1.36 0.02"/>
            </Shape>
        </Transform>

        <Transform translation="0 0.715 -0.34">
            <Shape DEF="WINDOW_FRAME_H">
                <Appearance DEF="WINDOW_FRAME_APPEARANCE">
                    <Material diffuseColor="0.92 0.91 0.87"/>
                </Appearance>
                <Box size="2.3 0.07 0.08"/>
            </Shape>
        </Transform>
        <Transform translation="0 -0.715 -0.34"><Shape USE="WINDOW_FRAME_H"/></Transform>

        <Transform translation="-1.115 0 -0.34">
            <Shape DEF="WINDOW_FRAME_V">
                <Appearance USE="WINDOW_FRAME_APPEARANCE"/>
                <Box size="0.07 1.5 0.08"/>
            </Shape>
        </Transform>
        <Transform translation="1.115 0 -0.34"><Shape USE="WINDOW_FRAME_V"/></Transform>

        <!-- 3 szyby po 0.673 m: (2.16 - 2 * 0.07) / 3 -->
        <Transform translation="-0.372 0 -0.34">
            <Shape DEF="WINDOW_MULLION">
                <Appearance>
                    <Material diffuseColor="0.85 0.87 0.85"/>
                </Appearance>
                <Box size="0.07 1.36 0.08"/>
            </Shape>
        </Transform>
        <Transform translation="0.372 0 -0.34"><Shape USE="WINDOW_MULLION"/></Transform>

    </Group>


    <!-- ====================================== -->
    <!-- OKNA W PARACH -->
    <!-- ====================================== -->

    <!-- Szyba od strony sąsiedniego okna szklana tylko u góry (ok. 2/5 wysokości).
         Dół otworu od słupka do krawędzi wypełniony równo z licem ściany -->
    <Group DEF="SHORT_PANE_FILL">
        <Transform translation="0 -0.325 -0.19">
            <Shape>
                <Appearance>
                    <Material diffuseColor="0.78 0.77 0.73"/>
                </Appearance>
                <Box size="0.743 0.85 0.38"/>
            </Shape>
        </Transform>

        <Transform translation="0 0.135 -0.34">
            <Shape>
                <Appearance>
                    <Material diffuseColor="0.85 0.87 0.85"/>
                </Appearance>
                <Box size="0.743 0.07 0.08"/>
            </Shape>
        </Transform>
    </Group>

    <!-- Lewe okno w parze - skrócona prawa szyba -->
    <Group DEF="WINDOW_UNIT_PAIR_LEFT">
        <Group USE="WINDOW_UNIT"/>
        <Transform translation="0.7785 0 0"><Group USE="SHORT_PANE_FILL"/></Transform>
    </Group>

    <!-- Prawe okno w parze - skrócona lewa szyba -->
    <Group DEF="WINDOW_UNIT_PAIR_RIGHT">
        <Group USE="WINDOW_UNIT"/>
        <Transform translation="-0.7785 0 0"><Group USE="SHORT_PANE_FILL"/></Transform>
    </Group>


    <!-- ====================================== -->
    <!-- MODUŁ KONDYGNACJI -->
    <!-- ====================================== -->

    <Group DEF="FLOOR_MODULE">
        <!-- Część wspólna z parterem (FLOOR_MODULE_GROUND) -->
        <Group DEF="FACADE_COMMON">
        <!-- Ściana gr. 0.5 m (z: 9.5 .. 10.0). Lokalnie y: -0.1 .. 2.7 = jedna kondygnacja,
             otwory okienne y: 1.0 .. 2.5 -->
        <Transform translation="0 0.45 9.75">
            <Shape>
                <Appearance DEF="FACADE_WALL_APPEARANCE">
                    <Material diffuseColor="0.78 0.77 0.73"/>
                </Appearance>
                <Box size="36 1.1 0.5"/>
            </Shape>
        </Transform>

        <Transform translation="0 2.6 9.75">
            <Shape>
                <Appearance USE="FACADE_WALL_APPEARANCE"/>
                <Box size="36 0.2 0.5"/>
            </Shape>
        </Transform>

        <!-- 13 filarów między otworami - w środkach równych odstępów 0.646 m.
             Skrajne podzielone na pół: przy narożniku ściana w licu, przy oknie ciemny pasek (niżej) -->
        <Transform translation="-17.839 1.75 9.75">
            <Shape DEF="FACADE_PIER_EDGE">
                <Appearance USE="FACADE_WALL_APPEARANCE"/>
                <Box size="0.325 1.5 0.5"/>
            </Shape>
        </Transform>
        <Transform translation="17.839 1.75 9.75"><Shape USE="FACADE_PIER_EDGE"/></Transform>

        <!-- Między parami (od strony wysokich szyb): ciemne, cofnięte 15 cm - o połowę mniej niż okna (z: 9.5 .. 9.85) -->
        <Transform translation="-14.731 1.75 9.675">
            <Shape DEF="FACADE_PIER_DARK">
                <Appearance DEF="FACADE_DARK_APPEARANCE">
                    <Material diffuseColor="0.12 0.12 0.13"/>
                </Appearance>
                <Box size="0.648 1.5 0.35"/>
            </Shape>
        </Transform>
        <Transform translation="-8.839 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="-2.946 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="2.946 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="8.839 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="14.731 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>

        <!-- Przy skrajnych oknach: o połowę węższe -->
        <Transform translation="-17.515 1.75 9.675">
            <Shape DEF="FACADE_PIER_DARK_EDGE">
                <Appearance USE="FACADE_DARK_APPEARANCE"/>
                <Box size="0.325 1.5 0.35"/>
            </Shape>
        </Transform>
        <Transform translation="17.515 1.75 9.675"><Shape USE="FACADE_PIER_DARK_EDGE"/></Transform>
        </Group>

        <!-- W parach: dół w licu (razem z wypełnieniem skróconych szyb, y: 1.0 .. 1.85),
             góra między małymi szybami ciemna i cofnięta (y: 1.85 .. 2.5) -->
        <Transform translation="-11.785 1.425 9.75">
            <Shape DEF="FACADE_PIER_PAIR_LOW">
                <Appearance USE="FACADE_WALL_APPEARANCE"/>
                <Box size="0.648 0.85 0.5"/>
            </Shape>
        </Transform>
        <Transform translation="-5.892 1.425 9.75"><Shape USE="FACADE_PIER_PAIR_LOW"/></Transform>
        <Transform translation="0 1.425 9.75"><Shape USE="FACADE_PIER_PAIR_LOW"/></Transform>
        <Transform translation="5.892 1.425 9.75"><Shape USE="FACADE_PIER_PAIR_LOW"/></Transform>
        <Transform translation="11.785 1.425 9.75"><Shape USE="FACADE_PIER_PAIR_LOW"/></Transform>

        <Transform translation="-11.785 2.175 9.675">
            <Shape DEF="FACADE_PIER_PAIR_HIGH">
                <Appearance USE="FACADE_DARK_APPEARANCE"/>
                <Box size="0.648 0.65 0.35"/>
            </Shape>
        </Transform>
        <Transform translation="-5.892 2.175 9.675"><Shape USE="FACADE_PIER_PAIR_HIGH"/></Transform>
        <Transform translation="0 2.175 9.675"><Shape USE="FACADE_PIER_PAIR_HIGH"/></Transform>
        <Transform translation="5.892 2.175 9.675"><Shape USE="FACADE_PIER_PAIR_HIGH"/></Transform>
        <Transform translation="11.785 2.175 9.675"><Shape USE="FACADE_PIER_PAIR_HIGH"/></Transform>

        <!-- 12 okien (otwór 2.3 m) i 13 równych odstępów: (36 - 12 * 2.3) / 13 = 0.646 m,
             rozstaw środków 2.946 m. z = 10.0 to lico ściany -->
        <Transform translation="-16.204 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="-13.258 1.75 10"><Group USE="WINDOW_UNIT_PAIR_LEFT"/></Transform>
        <Transform translation="-10.312 1.75 10"><Group USE="WINDOW_UNIT_PAIR_RIGHT"/></Transform>
        <Transform translation="-7.365 1.75 10"><Group USE="WINDOW_UNIT_PAIR_LEFT"/></Transform>
        <Transform translation="-4.419 1.75 10"><Group USE="WINDOW_UNIT_PAIR_RIGHT"/></Transform>
        <Transform translation="-1.473 1.75 10"><Group USE="WINDOW_UNIT_PAIR_LEFT"/></Transform>
        <Transform translation="1.473 1.75 10"><Group USE="WINDOW_UNIT_PAIR_RIGHT"/></Transform>
        <Transform translation="4.419 1.75 10"><Group USE="WINDOW_UNIT_PAIR_LEFT"/></Transform>
        <Transform translation="7.365 1.75 10"><Group USE="WINDOW_UNIT_PAIR_RIGHT"/></Transform>
        <Transform translation="10.312 1.75 10"><Group USE="WINDOW_UNIT_PAIR_LEFT"/></Transform>
        <Transform translation="13.258 1.75 10"><Group USE="WINDOW_UNIT_PAIR_RIGHT"/></Transform>
        <Transform translation="16.204 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>

    </Group>


    <!-- Parter: wszystkie okna pełne (bez skróconych szyb),
         więc filary w miejscu par też ciemne i cofnięte na całą wysokość -->
    <Group DEF="FLOOR_MODULE_GROUND">
        <Group USE="FACADE_COMMON"/>

        <Transform translation="-11.785 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="-5.892 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="0 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="5.892 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>
        <Transform translation="11.785 1.75 9.675"><Shape USE="FACADE_PIER_DARK"/></Transform>

        <Transform translation="-16.204 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="-13.258 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="-10.312 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="-7.365 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="-4.419 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="-1.473 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="1.473 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="4.419 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="7.365 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="10.312 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="13.258 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
        <Transform translation="16.204 1.75 10"><Group USE="WINDOW_UNIT"/></Transform>
    </Group>


    <!-- ====================================== -->
    <!-- MODUŁ BALKONU WE WNĘCE -->
    <!-- ====================================== -->

    <!-- y = 0 to poziom podłogi kondygnacji -->
    <Group DEF="BALCONY_MODULE">

        <Transform translation="-15.35 -0.1 0">
            <Shape>
                <Appearance>
                    <Material diffuseColor="0.91 0.90 0.86"/>
                </Appearance>
                <Box size="1.5 0.2 5.6"/>
            </Shape>
        </Transform>

        <Transform translation="-16.04 0.3 0">
            <Shape>
                <Appearance>
                    <Material diffuseColor="0.88 0.87 0.83"/>
                </Appearance>
                <Box size="0.12 0.6 5.6"/>
            </Shape>
        </Transform>

        <!-- Kratka: kafel 8x8 px = jedno oczko (drut w 1. wierszu i 1. kolumnie).
             Skala tekstury = wymiar / 0.03 m, czyli 5.6 -> 186.67, 2.0 -> 66.67 -->
        <Transform translation="-16.04 1.6 0">
            <Shape>
                <Appearance>
                    <Material DEF="MESH_MATERIAL"
                              diffuseColor="0.35 0.35 0.35"
                              transparency="0.05"/>
                    <PixelTexture DEF="WIRE_MESH"
                        image="8 8 4
                        0x404040FF 0x404040FF 0x404040FF 0x404040FF 0x404040FF 0x404040FF 0x404040FF 0x404040FF
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000
                        0x404040FF 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000 0x00000000"/>
                    <TextureTransform scale="186.67 66.67"/>
                </Appearance>
                <Box size="0.02 2.0 5.6"/>
            </Shape>
        </Transform>

        <!-- Płaskowniki 3 cm dzielące kratkę -->
        <Transform translation="-16.04 1.6 -2.785">
            <Shape DEF="BALCONY_BAR_V">
                <Appearance DEF="FLAT_BAR_APPEARANCE">
                    <Material diffuseColor="0.30 0.30 0.30"
                              specularColor="0.4 0.4 0.4"
                              shininess="0.3"/>
                </Appearance>
                <Box size="0.03 2.0 0.03"/>
            </Shape>
        </Transform>
        <Transform translation="-16.04 1.6 -1.4"><Shape USE="BALCONY_BAR_V"/></Transform>
        <Transform translation="-16.04 1.6 0"><Shape USE="BALCONY_BAR_V"/></Transform>
        <Transform translation="-16.04 1.6 1.4"><Shape USE="BALCONY_BAR_V"/></Transform>
        <Transform translation="-16.04 1.6 2.785"><Shape USE="BALCONY_BAR_V"/></Transform>

        <Transform translation="-16.04 0.615 0">
            <Shape DEF="BALCONY_BAR_H">
                <Appearance USE="FLAT_BAR_APPEARANCE"/>
                <Box size="0.03 0.03 5.6"/>
            </Shape>
        </Transform>
        <Transform translation="-16.04 2.585 0"><Shape USE="BALCONY_BAR_H"/></Transform>

        <!-- Ściana balkonu: drzwi | murek 0.3 | 3 okna od 0.6 m | murek 0.3 | drzwi.
             Rama to prostokąt za szybą, większy o 5 cm z każdej strony -->
        <Transform translation="-14.62 1.3 -2.3">
            <Shape DEF="BALCONY_DOOR_FRAME">
                <Appearance DEF="GLAZING_FRAME_APPEARANCE">
                    <Material diffuseColor="0.92 0.91 0.87"/>
                </Appearance>
                <Box size="0.04 2.6 1.0"/>
            </Shape>
        </Transform>
        <Transform translation="-14.62 1.3 2.3"><Shape USE="BALCONY_DOOR_FRAME"/></Transform>

        <Transform translation="-14.65 1.3 -2.3">
            <Shape DEF="BALCONY_DOOR_GLASS">
                <Appearance DEF="GLASS_APPEARANCE">
                    <Material diffuseColor="0.17 0.27 0.32"
                              specularColor="0.5 0.5 0.5"
                              shininess="0.6"/>
                </Appearance>
                <Box size="0.02 2.5 0.9"/>
            </Shape>
        </Transform>
        <Transform translation="-14.65 1.3 2.3"><Shape USE="BALCONY_DOOR_GLASS"/></Transform>

        <Transform translation="-14.665 1.3 -2.3">
            <Shape DEF="BALCONY_DOOR_BAR">
                <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
                <Box size="0.03 0.05 0.9"/>
            </Shape>
        </Transform>
        <Transform translation="-14.665 1.3 2.3"><Shape USE="BALCONY_DOOR_BAR"/></Transform>

        <Transform translation="-14.68 1.05 -1.9">
            <Shape DEF="DOOR_HANDLE">
                <Appearance USE="FLAT_BAR_APPEARANCE"/>
                <Box size="0.04 0.25 0.03"/>
            </Shape>
        </Transform>
        <Transform translation="-14.68 1.05 1.9"><Shape USE="DOOR_HANDLE"/></Transform>

        <Transform translation="-14.62 1.6 -1">
            <Shape DEF="BALCONY_WINDOW_FRAME">
                <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
                <Box size="0.04 2.0 1.0"/>
            </Shape>
        </Transform>
        <Transform translation="-14.62 1.6 0"><Shape USE="BALCONY_WINDOW_FRAME"/></Transform>
        <Transform translation="-14.62 1.6 1"><Shape USE="BALCONY_WINDOW_FRAME"/></Transform>

        <Transform translation="-14.65 1.6 -1">
            <Shape DEF="BALCONY_WINDOW_GLASS">
                <Appearance USE="GLASS_APPEARANCE"/>
                <Box size="0.02 1.9 0.9"/>
            </Shape>
        </Transform>
        <Transform translation="-14.65 1.6 0"><Shape USE="BALCONY_WINDOW_GLASS"/></Transform>
        <Transform translation="-14.65 1.6 1"><Shape USE="BALCONY_WINDOW_GLASS"/></Transform>

    </Group>


    <!-- ====================================== -->
    <!-- MODUŁ KLATKI EWAKUACYJNEJ -->
    <!-- ====================================== -->

    <!-- y = 0 to poziom podłogi kondygnacji, moduł schodzi do y = -2.8 -->
    <Group DEF="FIRE_ESCAPE_MODULE">

        <!-- Ściana klatki: okno | drzwi | okno | drzwi | okno, po 1.12 m, na całą wysokość.
             Wszystkie pola przedzielone w połowie wysokości -->
        <Group DEF="FIRE_WALL_GLAZING">
            <Transform translation="14.62 1.3 -2.24">
                <Shape DEF="FIRE_PANEL_FRAME">
                    <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
                    <Box size="0.04 2.6 1.12"/>
                </Shape>
            </Transform>
            <Transform translation="14.62 1.3 -1.12"><Shape USE="FIRE_PANEL_FRAME"/></Transform>
            <Transform translation="14.62 1.3 0"><Shape USE="FIRE_PANEL_FRAME"/></Transform>
            <Transform translation="14.62 1.3 1.12"><Shape USE="FIRE_PANEL_FRAME"/></Transform>
            <Transform translation="14.62 1.3 2.24"><Shape USE="FIRE_PANEL_FRAME"/></Transform>

            <Transform translation="14.65 1.3 -2.24">
                <Shape DEF="FIRE_PANEL_GLASS">
                    <Appearance USE="GLASS_APPEARANCE"/>
                    <Box size="0.02 2.5 1.02"/>
                </Shape>
            </Transform>
            <Transform translation="14.65 1.3 -1.12"><Shape USE="FIRE_PANEL_GLASS"/></Transform>
            <Transform translation="14.65 1.3 0"><Shape USE="FIRE_PANEL_GLASS"/></Transform>
            <Transform translation="14.65 1.3 1.12"><Shape USE="FIRE_PANEL_GLASS"/></Transform>
            <Transform translation="14.65 1.3 2.24"><Shape USE="FIRE_PANEL_GLASS"/></Transform>

            <Transform translation="14.665 1.3 -2.24">
                <Shape DEF="FIRE_WINDOW_BAR">
                    <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
                    <Box size="0.03 0.05 1.02"/>
                </Shape>
            </Transform>
            <Transform translation="14.665 1.3 -1.12"><Shape USE="FIRE_WINDOW_BAR"/></Transform>
            <Transform translation="14.665 1.3 0"><Shape USE="FIRE_WINDOW_BAR"/></Transform>
            <Transform translation="14.665 1.3 1.12"><Shape USE="FIRE_WINDOW_BAR"/></Transform>
            <Transform translation="14.665 1.3 2.24"><Shape USE="FIRE_WINDOW_BAR"/></Transform>

            <Transform translation="14.68 1.05 -0.72"><Shape USE="DOOR_HANDLE"/></Transform>
            <Transform translation="14.68 1.05 0.72"><Shape USE="DOOR_HANDLE"/></Transform>
        </Group>

        <!-- Płyta przy drzwiach i płyta pośrednia -->
        <Transform translation="15.1 -0.1 0">
            <Shape DEF="FIRE_LANDING">
                <Appearance>
                    <Material diffuseColor="0.91 0.90 0.86"/>
                </Appearance>
                <Box size="1.0 0.2 3.4"/>
            </Shape>
        </Transform>

        <Transform translation="17.5 -1.5 0">
            <Shape USE="FIRE_LANDING"/>
        </Transform>

        <!-- Bieg po prawej od drzwi: 7 stopni 0.2 x 0.2 m w dół, od budynku -->
        <Transform translation="15.7 -0.3 1.2">
            <Shape DEF="FIRE_STEP">
                <Appearance>
                    <Material diffuseColor="0.80 0.79 0.75"/>
                </Appearance>
                <Box size="0.2 0.2 1.0"/>
            </Shape>
        </Transform>
        <Transform translation="15.9 -0.5 1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.1 -0.7 1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.3 -0.9 1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.5 -1.1 1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.7 -1.3 1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.9 -1.5 1.2"><Shape USE="FIRE_STEP"/></Transform>

        <!-- Bieg po lewej: w stronę budynku, do płyty kondygnacji niżej -->
        <Transform translation="16.9 -1.7 -1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.7 -1.9 -1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.5 -2.1 -1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.3 -2.3 -1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="16.1 -2.5 -1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="15.9 -2.7 -1.2"><Shape USE="FIRE_STEP"/></Transform>
        <Transform translation="15.7 -2.9 -1.2"><Shape USE="FIRE_STEP"/></Transform>

        <!-- Murki biegów: równoległoboki z pionowymi końcami (x = 15.6 i 17.0),
             górą 0.6 m nad linią stopni, dołem 0.3 m pod nią -->
        <Transform translation="0 0 1.75">
            <Shape DEF="FLIGHT_PARAPET_OUT">
                <Appearance DEF="FIRE_PARAPET_APPEARANCE">
                    <Material diffuseColor="0.88 0.87 0.83"/>
                </Appearance>
                <IndexedFaceSet solid="false"
                    coordIndex="0 1 2 3 -1 4 5 6 7 -1 0 1 5 4 -1 1 2 6 5 -1 2 3 7 6 -1 3 0 4 7 -1">
                    <Coordinate point="15.6 0.6 -0.05, 17.0 -0.8 -0.05, 17.0 -1.7 -0.05, 15.6 -0.3 -0.05,
                                       15.6 0.6 0.05, 17.0 -0.8 0.05, 17.0 -1.7 0.05, 15.6 -0.3 0.05"/>
                </IndexedFaceSet>
            </Shape>
        </Transform>

        <Transform translation="0 0 -1.75">
            <Shape DEF="FLIGHT_PARAPET_IN">
                <Appearance USE="FIRE_PARAPET_APPEARANCE"/>
                <IndexedFaceSet solid="false"
                    coordIndex="0 1 2 3 -1 4 5 6 7 -1 0 1 5 4 -1 1 2 6 5 -1 2 3 7 6 -1 3 0 4 7 -1">
                    <Coordinate point="17.0 -0.8 -0.05, 15.6 -2.2 -0.05, 15.6 -3.1 -0.05, 17.0 -1.7 -0.05,
                                       17.0 -0.8 0.05, 15.6 -2.2 0.05, 15.6 -3.1 0.05, 17.0 -1.7 0.05"/>
                </IndexedFaceSet>
            </Shape>
        </Transform>

        <!-- Murki płyt tam, gdzie nie ma kratki -->
        <Transform translation="15.1 0.2 1.75">
            <Shape DEF="LANDING_PARAPET_END">
                <Appearance USE="FIRE_PARAPET_APPEARANCE"/>
                <Box size="1.0 0.8 0.1"/>
            </Shape>
        </Transform>
        <Transform translation="15.1 0.2 -1.75"><Shape USE="LANDING_PARAPET_END"/></Transform>
        <Transform translation="17.5 -1.2 1.75"><Shape USE="LANDING_PARAPET_END"/></Transform>
        <Transform translation="17.5 -1.2 -1.75"><Shape USE="LANDING_PARAPET_END"/></Transform>

        <Transform translation="15.65 0.2 0">
            <Shape DEF="LANDING_PARAPET_WELL">
                <Appearance USE="FIRE_PARAPET_APPEARANCE"/>
                <Box size="0.1 0.8 1.2"/>
            </Shape>
        </Transform>
        <Transform translation="16.95 -1.2 0"><Shape USE="LANDING_PARAPET_WELL"/></Transform>

        <!-- Siatka 0.6 m na zewnętrznej krawędzi płyty pośredniej (3.4 / 0.03, 0.6 / 0.03) -->
        <Transform translation="17.95 -1.1 0">
            <Shape>
                <Appearance>
                    <Material USE="MESH_MATERIAL"/>
                    <PixelTexture USE="WIRE_MESH"/>
                    <TextureTransform scale="113.33 20"/>
                </Appearance>
                <Box size="0.02 0.6 3.4"/>
            </Shape>
        </Transform>

        <Transform translation="17.95 -1.1 -1.685">
            <Shape DEF="FIRE_BAR_V">
                <Appearance USE="FLAT_BAR_APPEARANCE"/>
                <Box size="0.03 0.6 0.03"/>
            </Shape>
        </Transform>
        <Transform translation="17.95 -1.1 0"><Shape USE="FIRE_BAR_V"/></Transform>
        <Transform translation="17.95 -1.1 1.685"><Shape USE="FIRE_BAR_V"/></Transform>

        <Transform translation="17.95 -1.385 0">
            <Shape>
                <Appearance USE="FLAT_BAR_APPEARANCE"/>
                <Box size="0.03 0.03 3.4"/>
            </Shape>
        </Transform>

        <!-- Rury uniesione 5 cm nad murkami i kratką na nóżkach -->

        <!-- Rura nad siatką - Cylinder obrócony z osi Y na oś Z -->
        <Transform translation="17.95 -0.725 0" rotation="1 0 0 1.5708">
            <Shape>
                <Appearance DEF="PIPE_APPEARANCE">
                    <Material diffuseColor="0.30 0.30 0.30"
                              specularColor="0.5 0.5 0.5"
                              shininess="0.4"/>
                </Appearance>
                <Cylinder radius="0.025" height="3.5"/>
            </Shape>
        </Transform>

        <!-- Łączniki: od końca rury na biegu (x = 17.0) do rury nad siatką (x = 17.95),
             po murkach krótkich boków płyty - Cylinder obrócony z osi Y na oś X -->
        <Transform translation="17.475 -0.725 1.75" rotation="0 0 1 1.5708">
            <Shape DEF="LANDING_PIPE">
                <Appearance USE="PIPE_APPEARANCE"/>
                <Cylinder radius="0.025" height="0.95"/>
            </Shape>
        </Transform>
        <Transform translation="17.475 -0.725 -1.75" rotation="0 0 1 1.5708">
            <Shape USE="LANDING_PIPE"/>
        </Transform>

        <!-- Kule w narożnikach i na załamaniu 45° - zakrywają szczeliny między walcami -->
        <Transform translation="17.0 -0.72 1.75">
            <Shape DEF="PIPE_JOINT">
                <Appearance USE="PIPE_APPEARANCE"/>
                <Sphere radius="0.025"/>
            </Shape>
        </Transform>
        <Transform translation="17.0 -0.72 -1.75"><Shape USE="PIPE_JOINT"/></Transform>
        <Transform translation="17.95 -0.725 1.75"><Shape USE="PIPE_JOINT"/></Transform>
        <Transform translation="17.95 -0.725 -1.75"><Shape USE="PIPE_JOINT"/></Transform>

        <!-- Rury na murkach biegów - Cylinder obrócony z osi Y wzdłuż spadku 45° -->
        <Transform translation="16.3 -0.015 1.75" rotation="0 0 1 0.7854">
            <Shape DEF="FLIGHT_PIPE">
                <Appearance USE="PIPE_APPEARANCE"/>
                <Cylinder radius="0.025" height="1.98"/>
            </Shape>
        </Transform>
        <Transform translation="16.3 -1.415 -1.75" rotation="0 0 1 -0.7854">
            <Shape USE="FLIGHT_PIPE"/>
        </Transform>

        <!-- Nóżki 5 cm: nad płaskownikami kratki, na środku łączników i po dwie na biegach -->
        <Transform translation="17.95 -0.775 -1.685">
            <Shape DEF="PIPE_POST">
                <Appearance USE="PIPE_APPEARANCE"/>
                <Cylinder radius="0.012" height="0.05"/>
            </Shape>
        </Transform>
        <Transform translation="17.95 -0.775 0"><Shape USE="PIPE_POST"/></Transform>
        <Transform translation="17.95 -0.775 1.685"><Shape USE="PIPE_POST"/></Transform>

        <Transform translation="17.475 -0.775 1.75"><Shape USE="PIPE_POST"/></Transform>
        <Transform translation="17.475 -0.775 -1.75"><Shape USE="PIPE_POST"/></Transform>

        <Transform translation="15.95 0.275 1.75"><Shape USE="PIPE_POST"/></Transform>
        <Transform translation="16.65 -0.425 1.75"><Shape USE="PIPE_POST"/></Transform>
        <Transform translation="16.65 -1.125 -1.75"><Shape USE="PIPE_POST"/></Transform>
        <Transform translation="15.95 -1.825 -1.75"><Shape USE="PIPE_POST"/></Transform>

        <!-- Rurki na murkach płyty przy drzwiach: od ściany (x = 14.6) do rurek biegów (x = 15.6) -->
        <Group DEF="LANDING_RAIL">
            <Transform translation="15.1 0.675 1.75" rotation="0 0 1 1.5708">
                <Shape DEF="DOOR_LANDING_PIPE">
                    <Appearance USE="PIPE_APPEARANCE"/>
                    <Cylinder radius="0.025" height="1.0"/>
                </Shape>
            </Transform>
            <Transform translation="15.1 0.675 -1.75" rotation="0 0 1 1.5708">
                <Shape USE="DOOR_LANDING_PIPE"/>
            </Transform>

            <Transform translation="15.6 0.68 1.75"><Shape USE="PIPE_JOINT"/></Transform>
            <Transform translation="15.6 0.68 -1.75"><Shape USE="PIPE_JOINT"/></Transform>

            <Transform translation="15.1 0.625 1.75"><Shape USE="PIPE_POST"/></Transform>
            <Transform translation="15.1 0.625 -1.75"><Shape USE="PIPE_POST"/></Transform>
        </Group>

    </Group>

    </Switch>

    <!-- ====================================== -->
    <!-- PIERWSZA DŁUGA ELEWACJA - 16 KONDYGNACJI -->
    <!-- ====================================== -->

    <Transform translation="0 0.1 0">
        <Group USE="FLOOR_MODULE_GROUND"/>
