    <Transform translation="15.65 42.625 -1.2"><Shape USE="PIPE_POST"/></Transform>
    <Transform translation="15.65 42.675 -1.75"><Shape USE="PIPE_JOINT"/></Transform>

    <!-- ====================================== -->
