<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3"
     xmlns="http://www.web3d.org/specifications/x3d-namespace">

<!-- Wejście główne we wnęce (x: -18 .. -14.6, z: -2.8 .. 2.8): przeszklenie, schody, daszek, napis.
     Współrzędne budynku: y = 0 to podłoga parteru, teren na y = -0.6 -->

<Scene>

    <!-- ====================================== -->
    <!-- WEJŚCIE GŁÓWNE DS1 OLIMP -->
    <!-- ====================================== -->

    <!-- okno | drzwi | drzwi | okno na całą szerokość wnęki, szyby po 1.30 m,
         wszystkie przedzielone w połowie wysokości -->
    <!-- Rama z listew: górna i dolna 5 cm, boczne 5 cm, 3 słupki 10 cm między szybami -->
    <Transform translation="-14.45 2.175 0">
        <Shape DEF="ENTRANCE_FRAME_H">
            <Appearance DEF="GLAZING_FRAME_APPEARANCE">
                <Material diffuseColor="0.92 0.91 0.87"/>
            </Appearance>
            <Box size="0.04 0.05 5.6"/>
        </Shape>
    </Transform>
    <Transform translation="-14.45 0.025 0"><Shape USE="ENTRANCE_FRAME_H"/></Transform>

    <Transform translation="-14.45 1.1 -2.775">
        <Shape DEF="ENTRANCE_FRAME_SIDE">
            <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
            <Box size="0.04 2.2 0.05"/>
        </Shape>
    </Transform>
    <Transform translation="-14.45 1.1 2.775"><Shape USE="ENTRANCE_FRAME_SIDE"/></Transform>

    <Transform translation="-14.45 1.1 -1.4">
        <Shape DEF="ENTRANCE_FRAME_MULLION">
            <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
            <Box size="0.04 2.2 0.1"/>
        </Shape>
    </Transform>
    <Transform translation="-14.45 1.1 0"><Shape USE="ENTRANCE_FRAME_MULLION"/></Transform>
    <Transform translation="-14.45 1.1 1.4"><Shape USE="ENTRANCE_FRAME_MULLION"/></Transform>

    <Transform translation="-14.48 1.1 -2.1">
        <Shape DEF="ENTRANCE_GLASS">
            <Appearance>
                <Material diffuseColor="0.17 0.27 0.32"
                          specularColor="0.5 0.5 0.5"
                          shininess="0.6"
                          transparency="0.6"/>
            </Appearance>
            <Box size="0.02 2.1 1.3"/>
        </Shape>
    </Transform>
    <Transform translation="-14.48 1.1 -0.7"><Shape USE="ENTRANCE_GLASS"/></Transform>
    <Transform translation="-14.48 1.1 0.7"><Shape USE="ENTRANCE_GLASS"/></Transform>
    <Transform translation="-14.48 1.1 2.1"><Shape USE="ENTRANCE_GLASS"/></Transform>

    <Transform translation="-14.495 1.1 -2.1">
        <Shape DEF="ENTRANCE_GLASS_BAR">
            <Appearance USE="GLAZING_FRAME_APPEARANCE"/>
            <Box size="0.03 0.05 1.3"/>
        </Shape>
    </Transform>
    <Transform translation="-14.495 1.1 -0.7"><Shape USE="ENTRANCE_GLASS_BAR"/></Transform>
    <Transform translation="-14.495 1.1 0.7"><Shape USE="ENTRANCE_GLASS_BAR"/></Transform>
    <Transform translation="-14.495 1.1 2.1"><Shape USE="ENTRANCE_GLASS_BAR"/></Transform>

    <Transform translation="-14.51 0.95 -0.1">
        <Shape DEF="DOOR_HANDLE">
            <Appearance>
                <Material diffuseColor="0.30 0.30 0.30"
                          specularColor="0.4 0.4 0.4"
                          shininess="0.3"/>
            </Appearance>
            <Box size="0.04 0.25 0.03"/>
        </Shape>
    </Transform>
    <Transform translation="-14.51 0.95 0.1"><Shape USE="DOOR_HANDLE"/></Transform>


    <!-- ====================================== -->
    <!-- SCHODY PRZED WNĘKĄ -->
    <!-- ====================================== -->

    <!-- Teren jest tu na y = -0.6 (budynek podniesiony o 0.6) -->
    <Transform translation="-18.1 -0.36 0">
        <Shape>
            <Appearance DEF="STEP_APPEARANCE">
                <Material diffuseColor="0.72 0.71 0.68"/>
            </Appearance>
            <Box size="0.4 0.48 5.6"/>
        </Shape>
    </Transform>

    <Transform translation="-18.45 -0.44 0">
        <Shape>
            <Appearance USE="STEP_APPEARANCE"/>
            <Box size="0.3 0.32 5.6"/>
        </Shape>
    </Transform>

    <Transform translation="-18.75 -0.52 0">
        <Shape>
            <Appearance USE="STEP_APPEARANCE"/>
            <Box size="0.3 0.16 5.6"/>
        </Shape>
    </Transform>


    <!-- ====================================== -->
    <!-- DASZEK NAD WEJŚCIEM GŁÓWNYM -->
    <!-- ====================================== -->

    <!-- Od tylnej ściany wnęki 4 m na zewnątrz, wierzch tuż pod płytą 1. balkonu (y = 3.0).
         Murek tylko poza obrysem balkonu (x < -16.1), żeby z nim nie kolidował -->
    <Transform translation="-16.6 2.875 0">
        <Shape>
            <Appearance DEF="CANOPY_APPEARANCE">
                <Material diffuseColor="0.86 0.85 0.81"/>
            </Appearance>
            <Box size="4.0 0.25 3.4"/>
        </Shape>
    </Transform>

    <Transform translation="-18.55 3.2 0">
        <Shape>
            <Appearance USE="CANOPY_APPEARANCE"/>
            <Box size="0.1 0.4 3.4"/>
        </Shape>
    </Transform>

    <Transform translation="-17.35 3.2 1.65">
        <Shape DEF="CANOPY_PARAPET_SIDE">
            <Appearance USE="CANOPY_APPEARANCE"/>
            <Box size="2.5 0.4 0.1"/>
        </Shape>
    </Transform>
    <Transform translation="-17.35 3.2 -1.65"><Shape USE="CANOPY_PARAPET_SIDE"/></Transform>


    <!-- ====================================== -->
    <!-- NAPIS OLIMP -->
    <!-- ====================================== -->

    <Transform translation="-18.08 2.5 6.4"
               rotation="0 1 0 -1.5708">

        <Shape>
            <Appearance>
                <Material diffuseColor="0.05 0.05 0.05"
                          emissiveColor="0.03 0.03 0.03"/>
            </Appearance>

            <Text string='"OLIMP"'>
                <FontStyle size="1.1"
                           family='"SANS"'
                           style="BOLD"
                           justify='"MIDDLE" "BEGIN"'/>
            </Text>
        </Shape>

    </Transform>

</Scene>
</X3D>