<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3"
     xmlns="http://www.web3d.org/specifications/x3d-namespace">

<!-- Rdzeń holu na piętrach: kuchnia wspólna, windy, wolna przestrzeń z filarami, klatka schodowa,
     sanitariaty. Rdzeń z: -1.7 .. 1.7, długie hole z: ±1.7 .. ±2.9, krótki hol x: 13.25 .. 14.3.
     Współrzędne budynku: y = 0 to podłoga parteru -->

<Scene>

    <Switch whichChoice="-1">

    <!-- ====================================== -->
    <!-- ŚCIANA RDZENIA OD STRONY HOLU -->
    <!-- ====================================== -->

    <!-- Jedna ściana gr. 0.15 m (z = 0 to jej środek), wstawiana przy z = ±1.625.
         Wysokość pełnej kondygnacji (2.8 m) - wchodzi w strop, żeby rdzeń był ciągły.
         Drzwi 0.9-1.0 x 2.1 m: kuchnia x: -12.2 .. -11.3, schody x: 2.85 .. 3.85.
         Ściany sanitariatów (x: 7.8 .. 13.1) są osobno w HALL_CORE_COMMON - drzwi różne z obu stron -->
    <Group DEF="HALL_CORE_SIDE_WALL">
        <Transform translation="-13.25 1.4 0">
            <Shape>
                <Appearance DEF="CORE_WALL_APPEARANCE">
                    <Material diffuseColor="0.92 0.91 0.88"/>
                </Appearance>
                <Box size="2.1 2.8 0.15"/>
            </Shape>
        </Transform>
        <Transform translation="-9.45 1.4 0">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="3.7 2.8 0.15"/>
            </Shape>
        </Transform>
        <Transform translation="-11.75 2.45 0">
            <Shape DEF="CORE_DOOR_LINTEL">
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="0.9 0.7 0.15"/>
            </Shape>
        </Transform>

        <Transform translation="5.825 1.4 0">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="3.95 2.8 0.15"/>
            </Shape>
        </Transform>
        <Transform translation="3.35 2.45 0">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="1.0 0.7 0.15"/>
            </Shape>
        </Transform>

    </Group>


    <!-- ====================================== -->
    <!-- RDZEŃ - CZĘŚĆ WSPÓLNA DLA WSZYSTKICH PIĘTER -->
    <!-- ====================================== -->

    <Group DEF="HALL_CORE_COMMON">
        <Transform translation="0 0 1.625"><Group USE="HALL_CORE_SIDE_WALL"/></Transform>
        <Transform translation="0 0 -1.625"><Group USE="HALL_CORE_SIDE_WALL"/></Transform>

        <!-- Szyby wind: po 2 szyby jeden za drugim (górny otwiera się do górnego holu, dolny do dolnego).
             Parzyste x: -7.6 .. -5.8, nieparzyste x: 0.9 .. 2.7 -->
        <Transform translation="-6.7 1.4 0">
            <Shape DEF="ELEVATOR_SHAFTS">
                <Appearance>
                    <Material diffuseColor="0.70 0.70 0.68"/>
                </Appearance>
                <Box size="1.8 2.8 3.4"/>
            </Shape>
        </Transform>
        <Transform translation="1.8 1.4 0"><Shape USE="ELEVATOR_SHAFTS"/></Transform>

        <!-- Filary (wentylacja) w wolnej przestrzeni między windami -->
        <Transform translation="-2.8 1.4 1.2">
            <Shape DEF="HALL_PILLAR">
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="0.4 2.8 0.4"/>
            </Shape>
        </Transform>
        <Transform translation="-1.8 1.4 -1.2"><Shape USE="HALL_PILLAR"/></Transform>

        <!-- Klatka schodowa x: 2.7 .. 7.8 (ściana od strony wind = szyb windy).
             Ściana od sanitariatów -->
        <Transform translation="7.725 1.4 0">
            <Shape DEF="CORE_CROSS_WALL">
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="0.15 2.8 3.4"/>
            </Shape>
        </Transform>

        <!-- Sanitariaty x: 7.8 .. 13.1 (schemat 12 x 10 kratek: kratka 0.44 m wzdłuż, 0.31 m w poprzek).
             Małe pomieszczenie x: 7.8 .. 9.57, z: -1.55 .. 0 - drzwi z dolnego holu w narożniku (x: 7.8 .. 8.7).
             Duże (w kształcie L) - drzwi z górnego holu (x: 9.57 .. 10.45).
             W prawych narożnikach obudowy instalacji w kształcie L -->

        <!-- Ściana od górnego holu (z = 1.625) -->
        <Transform translation="8.685 1.4 1.625">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="1.77 2.8 0.15"/>
            </Shape>
        </Transform>
        <Transform translation="10.01 2.45 1.625">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="0.88 0.7 0.15"/>
            </Shape>
        </Transform>
        <Transform translation="11.775 1.4 1.625">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="2.65 2.8 0.15"/>
            </Shape>
        </Transform>

        <!-- Ściana od dolnego holu (z = -1.625) -->
        <Transform translation="8.25 2.45 -1.625"><Shape USE="CORE_DOOR_LINTEL"/></Transform>
        <Transform translation="10.9 1.4 -1.625">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="4.4 2.8 0.15"/>
            </Shape>
        </Transform>

        <!-- Ściany małego pomieszczenia -->
        <Transform translation="9.57 1.4 -0.775">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="0.1 2.8 1.55"/>
            </Shape>
        </Transform>
        <Transform translation="8.71 1.4 0">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="1.82 2.8 0.1"/>
            </Shape>
        </Transform>

        <!-- Ścianka przy drzwiach dużego pomieszczenia -->
        <Transform translation="9.465 1.4 1.24">
            <Shape>
                <Appearance USE="CORE_WALL_APPEARANCE"/>
                <Box size="0.21 2.8 0.62"/>
            </Shape>
        </Transform>

        <!-- Obudowy instalacji w kształcie L w prawych narożnikach (dwa prostokąty na narożnik) -->
        <Transform translation="12.658 1.4 1.395">
            <Shape DEF="SANITARY_DUCT_LONG">
                <Appearance DEF="SANITARY_DUCT_APPEARANCE">
                    <Material diffuseColor="0.70 0.70 0.68"/>
                </Appearance>
                <Box size="0.883 2.8 0.31"/>
            </Shape>
        </Transform>
        <Transform translation="12.523 1.4 1.24">
            <Shape DEF="SANITARY_DUCT_SHORT">
                <Appearance USE="SANITARY_DUCT_APPEARANCE"/>
                <Box size="0.613 2.8 0.62"/>
            </Shape>
        </Transform>
        <Transform translation="12.658 1.4 -1.395"><Shape USE="SANITARY_DUCT_LONG"/></Transform>
        <Transform translation="12.523 1.4 -1.24"><Shape USE="SANITARY_DUCT_SHORT"/></Transform>

        <Transform translation="13.175 1.4 0"><Shape USE="CORE_CROSS_WALL"/></Transform>
    </Group>


    <!-- ====================================== -->
    <!-- DRZWI WIND I BIEGI SCHODÓW -->
    <!-- ====================================== -->

    <!-- Drzwi pary wind - po jednych na szyb (z = ±0.85), na ścianie zwróconej do wolnej przestrzeni.
         x = 0 to lico tej ściany -->
    <Group DEF="ELEVATOR_DOORS">
        <Transform translation="0 1.05 0.85">
            <Shape DEF="ELEVATOR_DOOR">
                <Appearance>
                    <Material diffuseColor="0.60 0.62 0.65"
                              specularColor="0.6 0.6 0.6"
                              shininess="0.5"/>
                </Appearance>
                <Box size="0.02 2.1 1.1"/>
            </Shape>
        </Transform>
        <Transform translation="0 1.05 -0.85"><Shape USE="ELEVATOR_DOOR"/></Transform>
    </Group>

    <!-- Dwa biegi po 8 stopni 0.175 x 0.28 m, szer. 1.5 m. Od podestu wejściowego (x: 2.85 .. 4.05,
         to strop piętra) w stronę klatki ewakuacyjnej, spocznik x: 6.01 .. 7.65 na 1.4 m,
         powrót do podestu piętra wyżej (2.8 m) -->
    <Group DEF="STAIR_FLIGHTS">
        <Transform translation="4.19 0.0875 0.85">
            <Shape DEF="STAIR_STEP">
                <Appearance DEF="STAIR_APPEARANCE">
                    <Material diffuseColor="0.75 0.74 0.70"/>
                </Appearance>
                <Box size="0.28 0.175 1.4"/>
            </Shape>
        </Transform>
        <Transform translation="4.47 0.2625 0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="4.75 0.4375 0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.03 0.6125 0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.31 0.7875 0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.59 0.9625 0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.87 1.1375 0.85"><Shape USE="STAIR_STEP"/></Transform>

        <Transform translation="6.83 1.3 0">
            <Shape>
                <Appearance USE="STAIR_APPEARANCE"/>
                <Box size="1.64 0.2 3.1"/>
            </Shape>
        </Transform>

        <Transform translation="5.87 1.4875 -0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.59 1.6625 -0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.31 1.8375 -0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="5.03 2.0125 -0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="4.75 2.1875 -0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="4.47 2.3625 -0.85"><Shape USE="STAIR_STEP"/></Transform>
        <Transform translation="4.19 2.5375 -0.85"><Shape USE="STAIR_STEP"/></Transform>

        <!-- Spód biegów jako płaska pochyła powierzchnia przez najniższe narożniki stopni,
             dokładnie na szerokość i długość pochyłej części biegu -->
        <Shape>
            <Appearance USE="STAIR_APPEARANCE"/>
            <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1">
                <Coordinate point="4.05 -0.175 0.15, 6.25 1.2 0.15, 6.25 1.2 1.55, 4.05 -0.175 1.55"/>
            </IndexedFaceSet>
        </Shape>
        <Shape>
            <Appearance USE="STAIR_APPEARANCE"/>
            <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1">
                <Coordinate point="6.05 1.2 -1.55, 3.81 2.6 -1.55, 3.81 2.6 -0.15, 6.05 1.2 -0.15"/>
            </IndexedFaceSet>
        </Shape>

        <!-- Policzki biegów od strony szczeliny (z = ±0.15): od równi pochyłej do linii krawędzi stopni -->
        <Shape>
            <Appearance USE="STAIR_APPEARANCE"/>
            <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1">
                <Coordinate point="4.05 -0.175 0.15, 6.01 1.05 0.15, 6.01 1.4 0.15, 4.05 0.175 0.15"/>
            </IndexedFaceSet>
        </Shape>
        <Shape>
            <Appearance USE="STAIR_APPEARANCE"/>
            <IndexedFaceSet solid="false" coordIndex="0 1 2 3 -1">
                <Coordinate point="6.01 1.225 -0.15, 4.05 2.45 -0.15, 4.05 2.8 -0.15, 6.01 1.575 -0.15"/>
            </IndexedFaceSet>
        </Shape>

        <!-- Balustrada ciągła wokół szczeliny między biegami. Ścieżka (y = 0 na linii krawędzi stopni):
             bieg 1 przy z = 0.08 -> półokrąg r = 0.08 nad spocznikiem -> bieg 2 przy z = -0.08 ->
             półokrąg nad podestem piętra wyżej, koniec w punkcie startu balustrady następnego piętra.
             Odcinki z walców (Cylinder obrócony z osi Y na kierunek odcinka), łuki z 4 odcinków po 45°
             wznoszących się o 0.175 m, kule na wszystkich połączeniach.
             Ścieżka zdefiniowana dla rury (r = 2.5 cm) i dla prętów (r = 0.8 cm) -->
        <Transform translation="0 0.9 0">
            <Group DEF="STAIR_RAIL_PATH_THICK">
                <Transform translation="5.03 0.7875 0.08" rotation="0 0 1 -1.0122">
                    <Shape DEF="RAIL_STRAIGHT_THICK">
                        <Appearance DEF="STAIR_RAIL_APPEARANCE">
                            <Material diffuseColor="0.30 0.30 0.30"
                                      specularColor="0.5 0.5 0.5"
                                      shininess="0.4"/>
                        </Appearance>
                        <Cylinder radius="0.025" height="2.311"/>
                    </Shape>
                </Transform>
                <Transform translation="5.03 2.1875 -0.08" rotation="0 0 1 1.0122"><Shape USE="RAIL_STRAIGHT_THICK"/></Transform>

                <Transform translation="6.0383 1.421875 0.0683" rotation="-0.3827 0 -0.9239 0.9504">
                    <Shape DEF="RAIL_ARC_THICK">
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Cylinder radius="0.025" height="0.0753"/>
                    </Shape>
                </Transform>
                <Transform translation="6.0783 1.465625 0.0283" rotation="-0.9239 0 -0.3827 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>
                <Transform translation="6.0783 1.509375 -0.0283" rotation="-0.9239 0 0.3827 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>
                <Transform translation="6.0383 1.553125 -0.0683" rotation="-0.3827 0 0.9239 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>

                <Transform translation="4.0217 2.821875 -0.0683" rotation="0.3827 0 0.9239 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>
                <Transform translation="3.9817 2.865625 -0.0283" rotation="0.9239 0 0.3827 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>
                <Transform translation="3.9817 2.909375 0.0283" rotation="0.9239 0 -0.3827 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>
                <Transform translation="4.0217 2.953125 0.0683" rotation="0.3827 0 -0.9239 0.9504"><Shape USE="RAIL_ARC_THICK"/></Transform>

                <Transform translation="4.05 0.175 0.08">
                    <Shape DEF="RAIL_JOINT_THICK">
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Sphere radius="0.025"/>
                    </Shape>
                </Transform>
                <Transform translation="6.01 1.4 0.08"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="6.0666 1.44375 0.0566"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="6.09 1.4875 0"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="6.0666 1.53125 -0.0566"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="6.01 1.575 -0.08"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="4.05 2.8 -0.08"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="3.9934 2.84375 -0.0566"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="3.97 2.8875 0"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="3.9934 2.93125 0.0566"><Shape USE="RAIL_JOINT_THICK"/></Transform>
                <Transform translation="4.05 2.975 0.08"><Shape USE="RAIL_JOINT_THICK"/></Transform>
            </Group>
        </Transform>

        <Transform translation="0 0.75 0">
            <Group DEF="STAIR_RAIL_PATH_THIN">
                <Transform translation="5.03 0.7875 0.08" rotation="0 0 1 -1.0122">
                    <Shape DEF="RAIL_STRAIGHT_THIN">
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Cylinder radius="0.008" height="2.311"/>
                    </Shape>
                </Transform>
                <Transform translation="5.03 2.1875 -0.08" rotation="0 0 1 1.0122"><Shape USE="RAIL_STRAIGHT_THIN"/></Transform>

                <Transform translation="6.0383 1.421875 0.0683" rotation="-0.3827 0 -0.9239 0.9504">
                    <Shape DEF="RAIL_ARC_THIN">
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Cylinder radius="0.008" height="0.0753"/>
                    </Shape>
                </Transform>
                <Transform translation="6.0783 1.465625 0.0283" rotation="-0.9239 0 -0.3827 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>
                <Transform translation="6.0783 1.509375 -0.0283" rotation="-0.9239 0 0.3827 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>
                <Transform translation="6.0383 1.553125 -0.0683" rotation="-0.3827 0 0.9239 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>

                <Transform translation="4.0217 2.821875 -0.0683" rotation="0.3827 0 0.9239 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>
                <Transform translation="3.9817 2.865625 -0.0283" rotation="0.9239 0 0.3827 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>
                <Transform translation="3.9817 2.909375 0.0283" rotation="0.9239 0 -0.3827 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>
                <Transform translation="4.0217 2.953125 0.0683" rotation="0.3827 0 -0.9239 0.9504"><Shape USE="RAIL_ARC_THIN"/></Transform>

                <Transform translation="4.05 0.175 0.08">
                    <Shape DEF="RAIL_JOINT_THIN">
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Sphere radius="0.008"/>
                    </Shape>
                </Transform>
                <Transform translation="6.01 1.4 0.08"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="6.0666 1.44375 0.0566"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="6.09 1.4875 0"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="6.0666 1.53125 -0.0566"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="6.01 1.575 -0.08"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="4.05 2.8 -0.08"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="3.9934 2.84375 -0.0566"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="3.97 2.8875 0"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="3.9934 2.93125 0.0566"><Shape USE="RAIL_JOINT_THIN"/></Transform>
                <Transform translation="4.05 2.975 0.08"><Shape USE="RAIL_JOINT_THIN"/></Transform>
            </Group>
        </Transform>
        <Transform translation="0 0.6 0"><Group USE="STAIR_RAIL_PATH_THIN"/></Transform>
        <Transform translation="0 0.45 0"><Group USE="STAIR_RAIL_PATH_THIN"/></Transform>
        <Transform translation="0 0.3 0"><Group USE="STAIR_RAIL_PATH_THIN"/></Transform>
        <Transform translation="0 0.15 0"><Group USE="STAIR_RAIL_PATH_THIN"/></Transform>

        <!-- Słupki na biegach: wychodzą poziomo z policzka (z = ±0.15) w połowie jego wysokości
             (0.175 m pod linią krawędzi stopni), kolano z kuli, potem pionowo 1.075 m do rury (z = ±0.08).
             Początek układu = kolano; drugi bieg to ten sam słupek obrócony o 180° wokół Y -->
        <Transform translation="4.07 0.0125 0.08">
            <Group DEF="STAIR_POST_BRACKET">
                <Transform translation="0 0 0.035" rotation="1 0 0 1.5708">
                    <Shape>
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Cylinder radius="0.025" height="0.07"/>
                    </Shape>
                </Transform>
                <Shape>
                    <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                    <Sphere radius="0.025"/>
                </Shape>
                <Transform translation="0 0.5375 0">
                    <Shape>
                        <Appearance USE="STAIR_RAIL_APPEARANCE"/>
                        <Cylinder radius="0.025" height="1.075"/>
                    </Shape>
                </Transform>
            </Group>
        </Transform>
        <Transform translation="5.03 0.6125 0.08"><Group USE="STAIR_POST_BRACKET"/></Transform>
        <Transform translation="5.99 1.2125 0.08"><Group USE="STAIR_POST_BRACKET"/></Transform>

        <Transform translation="5.99 1.4125 -0.08" rotation="0 1 0 3.14159"><Group USE="STAIR_POST_BRACKET"/></Transform>
        <Transform translation="5.03 2.0125 -0.08" rotation="0 1 0 3.14159"><Group USE="STAIR_POST_BRACKET"/></Transform>
        <Transform translation="4.07 2.6125 -0.08" rotation="0 1 0 3.14159"><Group USE="STAIR_POST_BRACKET"/></Transform>

    </Group>

    <!-- ====================================== -->
    <!-- WARIANTY PIĘTRA -->
    <!-- ====================================== -->

    <!-- Windy stają tylko na swoich piętrach - druga para ma na tym piętrze gładką ścianę -->
    <!-- Parzyste: drzwi na ścianie x = -5.8, nieparzyste: na ścianie x = 0.9 (obie zwrócone do środka) -->
    <Group DEF="HALL_FLOOR_EVEN">
        <Group USE="HALL_CORE_COMMON"/>
        <Transform translation="-5.79 0 0"><Group USE="ELEVATOR_DOORS"/></Transform>
    </Group>

    <Group DEF="HALL_FLOOR_ODD">
        <Group USE="HALL_CORE_COMMON"/>
        <Transform translation="0.89 0 0"><Group USE="ELEVATOR_DOORS"/></Transform>
    </Group>

    </Switch>


    <!-- ====================================== -->
    <!-- PIĘTRA 1-15 (podłoga = wierzch stropu: 2.8 * k + 0.4, parter = 0) -->
    <!-- ====================================== -->

    <Transform translation="0 3.2 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 6.0 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 8.8 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 11.6 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 14.4 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 17.2 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 20.0 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 22.8 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 25.6 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 28.4 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 31.2 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 34.0 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 36.8 0"><Group USE="HALL_FLOOR_ODD"/></Transform>
    <Transform translation="0 39.6 0"><Group USE="HALL_FLOOR_EVEN"/></Transform>
    <Transform translation="0 42.4 0"><Group USE="HALL_FLOOR_ODD"/></Transform>

    <!-- Biegi schodów z pięter 1-14 na piętro wyżej (z najwyższego piętra nie ma wyjścia na dach) -->
    <Transform translation="0 3.2 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 6.0 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 8.8 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 11.6 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 14.4 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 17.2 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 20.0 0"><Group USE="STAIR_FLIGHTS"/></Transform>
    <Transform translation="0 22.8 0"><Group USE="STAIR_FLIGHTS"/></Transform>
