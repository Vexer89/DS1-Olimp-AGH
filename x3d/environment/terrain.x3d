<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3"
     xmlns="http://www.web3d.org/specifications/x3d-namespace">

<!-- Teren wokół budynku. Współrzędne świata: y = 0 to poziom terenu -->

<Scene>

    <Transform translation="0 -0.25 0">
        <Shape>
            <Appearance>
                <Material diffuseColor="0.38 0.40 0.36"/>
            </Appearance>
            <Box size="100 0.5 120"/>
        </Shape>
    </Transform>

</Scene>
</X3D>